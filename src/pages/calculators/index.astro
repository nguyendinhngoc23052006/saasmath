---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { CALCULATORS } from '@/data/calculators';
---
<BaseLayout
  title="All calculators"
  description="Every SaaS founder calculator on saasmath: runway, burn, LTV/CAC, MRR/ARR, quick ratio, Rule of 40, cap-table dilution, option value, seed sizing, bridge rounds."
  pathname="/calculators"
>
  <section class="mx-auto max-w-4xl px-4 py-10">
    <h1 class="text-3xl md:text-4xl font-semibold tracking-tight text-ink-900">All calculators</h1>
    <p class="mt-3 text-ink-700 leading-7 max-w-2xl">
      Every calculator is a single-page React island with URL-encoded state. Copy the link and the
      recipient sees your numbers. Nothing is stored server-side.
    </p>

    <ul class="mt-6 grid gap-3 sm:grid-cols-2">
      {CALCULATORS.map((c) => (
        <li>
          <a href={`/calculators/${c.slug}`} class="block h-full rounded-lg border border-ink-200 bg-white p-4 no-underline hover:border-accent-500">
            <div class="font-semibold text-ink-900">{c.h1}</div>
            <div class="mt-1 text-sm text-ink-600">{c.short}</div>
            <div class="mt-2 text-xs text-ink-500">Target: {c.targetKeyword}</div>
          </a>
        </li>
      ))}
    </ul>
  </section>
</BaseLayout>
