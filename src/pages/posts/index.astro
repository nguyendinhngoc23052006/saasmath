---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

const posts = (await getCollection('posts', ({ data }) => !data.draft))
  .sort((a, b) => (a.data.publishedAt < b.data.publishedAt ? 1 : -1));
---
<BaseLayout
  title="Writing"
  description="Guides to SaaS finance: runway, burn, LTV/CAC, dilution, option value, fundraising."
  pathname="/posts"
>
  <section class="mx-auto max-w-3xl px-4 py-10">
    <h1 class="text-3xl md:text-4xl font-semibold tracking-tight text-ink-900">Writing</h1>
    <p class="mt-3 text-ink-700 leading-7">
      One post per calculator. Formula, worked example, common mistakes, sources.
    </p>

    <ul class="mt-6 divide-y divide-ink-200 rounded-lg border border-ink-200 bg-white">
      {posts.map((p) => (
        <li>
          <a href={`/posts/${p.slug}`} class="block p-4 no-underline hover:bg-ink-50/60">
            <div class="text-sm text-ink-500">{p.data.publishedAt}</div>
            <div class="font-semibold text-ink-900">{p.data.title}</div>
            <div class="text-sm text-ink-600 mt-1">{p.data.description}</div>
          </a>
        </li>
      ))}
    </ul>
  </section>
</BaseLayout>
