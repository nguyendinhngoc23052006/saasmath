---
interface Props {
  items: { q: string; a: string }[];
}
const { items } = Astro.props;
---
{items.length > 0 && (
  <section class="mt-10">
    <h2 class="text-2xl font-semibold tracking-tight text-ink-900 mb-3">FAQ</h2>
    <div class="divide-y divide-ink-200 rounded-lg border border-ink-200 bg-white">
      {items.map((item) => (
        <details class="group px-4 py-3">
          <summary class="cursor-pointer list-none flex items-center justify-between text-ink-900 font-medium">
            <span>{item.q}</span>
            <span class="text-ink-400 group-open:rotate-45 transition-transform">+</span>
          </summary>
          <p class="mt-2 text-sm text-ink-700 leading-6">{item.a}</p>
        </details>
      ))}
    </div>
  </section>
)}
