---
import { CALCULATORS } from '@/data/calculators';

interface Props {
  slugs?: string[];
  exclude?: string;
}
const { slugs = [], exclude } = Astro.props;

const seen = new Set<string>();
const items = (slugs.length ? slugs : CALCULATORS.map((c) => c.slug))
  .filter((s) => s !== exclude && !seen.has(s) && (seen.add(s), true))
  .map((s) => CALCULATORS.find((c) => c.slug === s))
  .filter(Boolean)
  .slice(0, 4);
---
{items.length > 0 && (
  <section class="mt-10">
    <h2 class="text-2xl font-semibold tracking-tight text-ink-900 mb-3">Related calculators</h2>
    <ul class="grid gap-3 sm:grid-cols-2">
      {items.map((c) => c && (
        <li>
          <a
            href={`/calculators/${c.slug}`}
            class="block rounded-lg border border-ink-200 bg-white p-4 no-underline hover:border-accent-500"
          >
            <div class="font-semibold text-ink-900">{c.h1}</div>
            <div class="mt-1 text-sm text-ink-600">{c.short}</div>
          </a>
        </li>
      ))}
    </ul>
  </section>
)}
